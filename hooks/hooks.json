{
  "description": "Vortex Skills — reancoragem do ledger (SessionStart/PostCompact), fronteiras de seguranca (PreToolUse/Bash) e integridade do ledger (PreToolUse/Agent). Todos deterministicos e fail-open: excecao no script vira exit 0 silencioso, nunca bloqueio acidental.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/contexto.py"
            ],
            "timeout": 5,
            "statusMessage": "Vortex: lendo ledger"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/contexto.py"
            ],
            "timeout": 5,
            "statusMessage": "Vortex: reancorando ledger"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/fronteiras.py",
              "--nivel",
              "${user_config.VORTEX_NIVEL_FRONTEIRAS}"
            ],
            "timeout": 5,
            "statusMessage": "Vortex: fronteiras"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "-S",
              "${CLAUDE_PLUGIN_ROOT}/hooks/scripts/gate_despacho.py",
              "--nivel",
              "${user_config.VORTEX_NIVEL_LEDGER}"
            ],
            "timeout": 5,
            "statusMessage": "Vortex: ledger"
          }
        ]
      }
    ]
  }
}
